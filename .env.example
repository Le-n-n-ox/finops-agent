# Copy to .env — never commit .env
#
# The backend loads this file at startup (backend/app/config.py). Real environment
# variables still win over it, so a container's compose environment, a CI secret or
# an exported variable always takes precedence.
AGENT_RUNTIME=local            # local | meterless
DATA_SOURCE=local              # local | zetaris

# ---------------------------------------------------------------------------
# Local model server (Nightshift / meterless hotspot) — THIS is the model the
# agent cycle uses.
#
# The hotspot is an OpenAI-compatible API on the host. Its bearer token lives in
# a state directory beside it:
#   Windows: %LOCALAPPDATA%\ai.meterless.runtime\proxy-token
#   macOS:   ~/Library/Application Support/ai.meterless.runtime/proxy-token
#   Linux:   /var/lib/meterless/proxy-token
#
# Leave METERLESS_API_KEY empty and the app discovers the token file itself.
# A token never belongs anywhere except this gitignored .env.
# ---------------------------------------------------------------------------

# Base URL of the OpenAI-compatible server. /v1 is optional.
#   Host run:    http://127.0.0.1:8088/v1
#   Docker run:  http://host.docker.internal:8088/v1
# A container reaches the host through `host.docker.internal` (Docker Desktop's
# alias for the host gateway) or through the host's LAN address. The container's
# own 127.0.0.1 is the container, not the host, so it never reaches the hotspot.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1

# Model id, exactly as the server lists it. Verified ids include:
#   local-runtime/llama-3.3-70b-instruct, local-runtime/gpt-oss-20b,
#   meterless/auto, meterless/fast, local-runtime/qwen3.8-27b
# ("openai/gpt-oss-20b" does not exist; the correct id is "local-runtime/gpt-oss-20b")
#
# The default is the one that was benchmarked on tool-call reliability (5 runs
# each, 5/5 first-turn tool calls and 5/5 conclusions for llama-3.3-70b-instruct).
# A model that cannot reliably call a tool is worse than no model: it burns the
# cycle's iteration budget without gathering evidence.
METERLESS_MODEL=local-runtime/llama-3.3-70b-instruct

# Bearer token for the server above. Optional if the token file is discoverable.
METERLESS_API_KEY=

# Path to a file holding that bearer token. Optional; auto-discovered when unset.
METERLESS_TOKEN_FILE=

# The directory that holds the token file, so `docker compose` can bind-mount it
# read-only at /run/nightshift and the container reads the same token the host
# does. Set it to the directory named above (not the file):
#   Windows: C:/Users/<you>/AppData/Local/ai.meterless.runtime
#   macOS:   ~/Library/Application Support/ai.meterless.runtime
#   Linux:   /var/lib/meterless
METERLESS_STATE_DIR=

# ---------------------------------------------------------------------------
# Which reasoner runs the agent cycle
# ---------------------------------------------------------------------------
# auto      - probe for the model server and use it when one answers; fall back
#             to the deterministic stand-in when none does. The response says
#             which one ran, and the UI shows it.
# simulated - pin the deterministic stand-in. No model server is contacted, even
#             when one is running. Pin it for a reproducible demo, or in CI.
LLM_BACKEND=auto

# ---------------------------------------------------------------------------
# docker compose host ports
# ---------------------------------------------------------------------------
# The host ports the containers publish on. 8000 and 5173 are commonly taken by
# something else on the same machine (another project's container, a local dev
# server), so they are configurable. The ports INSIDE the containers are always
# 8000 and 5173, so the frontend's proxy to finops_agent:8000 never changes.
FINOPS_API_PORT=8000
FINOPS_WEB_PORT=5173

# ---------------------------------------------------------------------------
# Optional integrations
# ---------------------------------------------------------------------------

# Zetaris (see docs/ZETARIS_SETUP.md)
ZETARIS_BASE_URL=
ZETARIS_ORG_ID=
ZETARIS_USERNAME=
ZETARIS_PASSWORD=
ZETARIS_API_KEY=

# NVIDIA NIM — OPTIONAL and EXPLANATION-ONLY. This is a separate cloud service
# and it is NOT the model the agent cycle talks to; the agent cycle uses the
# METERLESS_* settings above. A key from https://build.nvidia.com.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
