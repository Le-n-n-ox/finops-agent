# Copy to .env — never commit .env
AGENT_RUNTIME=local            # local | meterless
DATA_SOURCE=local              # local | zetaris

# Zetaris (see docs/ZETARIS_SETUP.md)
ZETARIS_BASE_URL=
ZETARIS_ORG_ID=
ZETARIS_USERNAME=
ZETARIS_PASSWORD=
ZETARIS_API_KEY=

# NVIDIA NIM (optional, explanations only) — key from https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
